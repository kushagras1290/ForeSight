# Project FORESIGHT - configuration template
#
# Copy to `.env` and adjust. Every value below has a working default, so the
# pipeline runs with no .env at all; these exist so the client can retune the
# engagement without editing code. All are validated at startup by
# src/foresight/config.py - a bad value crashes immediately with a clear message
# rather than silently producing a wrong forecast.

# --- Reproducibility ---------------------------------------------------------
# Fixed seed is a requirement of brief section 16.3 (results must be re-creatable).
FORESIGHT_RANDOM_SEED=20260907

# --- Client extract shape ----------------------------------------------------
# Extracts are not tracked in git (brief section 16.3); these describe the shape
# the project expects and are used to materialise them into data/raw/.
FORESIGHT_N_SKUS=200
FORESIGHT_HISTORY_START=2023-01-02
FORESIGHT_HISTORY_END=2026-08-30

# --- Forecasting -------------------------------------------------------------
# Horizon in weeks. Brief section 4.2 specifies 6-8.
FORESIGHT_HORIZON_WEEKS=8
# Rolling-origin backtest: number of folds and the gap between origins.
FORESIGHT_BACKTEST_FOLDS=6
FORESIGHT_BACKTEST_STEP_WEEKS=4
# Minimum weeks of history before a SKU may enter the training set.
FORESIGHT_MIN_TRAIN_WEEKS=60
# Prediction interval coverage (0.8 => 10th/90th quantile models).
FORESIGHT_INTERVAL_COVERAGE=0.8

# --- Risk scoring ------------------------------------------------------------
# Target probability of NOT stocking out over the lead time (brief Appendix B).
FORESIGHT_SERVICE_LEVEL=0.95
# A SKU is flagged overstocked above this many weeks of forward cover.
FORESIGHT_OVERSTOCK_COVER_WEEKS=12
# Score above which a risk dimension counts as "high" on the decisioning grid.
FORESIGHT_RISK_HIGH_THRESHOLD=0.5
# Lead times outside this range are treated as data errors and imputed.
FORESIGHT_LEAD_TIME_MIN_DAYS=1
FORESIGHT_LEAD_TIME_MAX_DAYS=120

# --- Service (D6) ------------------------------------------------------------
FORESIGHT_API_TITLE=FORESIGHT Scoring Service
FORESIGHT_API_MAX_BATCH_SIZE=200
# Comma-separated origins allowed to call the API from a browser.
# Locked to the dashboard dev server by default; widen only for your deployment.
FORESIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging -----------------------------------------------------------------
FORESIGHT_LOG_LEVEL=INFO
# json = structured (production), console = human-readable (local development)
FORESIGHT_LOG_FORMAT=console

# --- Authentication ------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Application type: Web application.
# Authorized redirect URI must match FORESIGHT_GOOGLE_REDIRECT_URI exactly.
# Leave unset (or the placeholder values) to leave Google sign-in inactive -
# the button still renders, it just returns a clean "not configured" error.
FORESIGHT_GOOGLE_CLIENT_ID=
FORESIGHT_GOOGLE_CLIENT_SECRET=
FORESIGHT_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# How long a session lasts before the user has to sign in again.
FORESIGHT_SESSION_TTL_DAYS=7
# Set true once served over HTTPS in production - keep false for local http.
FORESIGHT_SESSION_COOKIE_SECURE=false
# Change this if running a second instance on the same machine/browser (e.g.
# a second localhost port) - cookies aren't port-scoped, so two instances
# using the same cookie name silently overwrite each other's session.
FORESIGHT_SESSION_COOKIE_NAME=fs_session

# --- Running more than one instance of this codebase --------------------------
# Leave unset to use the repo root (one instance, the normal case). Set this to
# give an instance its own data/, artifacts/ and reports/ - e.g. a client
# instance with its own real extracts, isolated from the demo/dev instance's
# data, artifacts and login accounts, while sharing the same code.
FORESIGHT_DATA_ROOT=
