# --- Client data -------------------------------------------------------------
# Section 16.3 of the brief: treat the client extracts as confidential and never
# commit raw dumps. See the README for how to materialise data/raw/ locally.
data/raw/*
data/interim/*
data/processed/*
data/holdout/*
# Generated test sets are demand data too. The READMEs are kept: they record what
# each set is and the score it produced, which is documentation rather than data.
data/testsets/**/*.csv
!data/**/.gitkeep
!data/**/README.md

# Staged copies of whichever raw extract is being compared (scripts/
# prepare_provided_extract.py, scripts/run_source_comparison.py) - client data
# under a different name, same confidentiality rule as data/raw/.
data/sources/

# Per-user accounts and session tokens. Never shared, never shipped with the repo -
# a fresh clone gets its own, created empty on first run (foresight.auth.init_auth_db).
data/auth.db

# Full snapshots of each source's pipeline run, kept locally for the comparison in
# reports/data_source_comparison.md but not meant to be pushed - same reasoning
# as artifacts/ and data/processed/ below, just under their own run-tagged copies.
runs/

# Ad-hoc, isolated FORESIGHT_DATA_ROOT runs (e.g. one-off benchmarks against a
# supplied dataset) - same reasoning as runs/ above, kept locally only.
runs_manual/

# --- Build artifacts ---------------------------------------------------------
artifacts/*
!artifacts/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
# eda_memo.md, executive_readout.pdf and data_source_comparison.md are, despite
# being pipeline output, tracked on purpose - they are the D2/D7 deliverables
# and the data-source decision record respectively, same reasoning as keeping
# data/testsets/**/README.md above: documentation, not data.

# The dashboard's own copy of reports/figures/, for the Executive Summary page's
# <img> tags (a Vite public/ asset has to be a real file, not a server-side
# redirect). Re-copy after regenerating figures: `cp reports/figures/*.png
# dashboard/public/figures/`. Same client-data rule as reports/figures/ itself.
dashboard/public/figures/*
!dashboard/public/figures/.gitkeep

# --- Logs ----------------------------------------------------------------------
*.log

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Node / dashboard --------------------------------------------------------
node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/tsconfig.tsbuildinfo
*.tsbuildinfo
*.local

# --- Tests -------------------------------------------------------------------
# Kept local rather than shared. Remove this entry to publish the suite.
tests/

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
